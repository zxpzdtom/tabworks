{
	"name": "tabworks-service",
	"version": "1.0.0",
	"description": "TabWorks Bridge local service for Chrome extension backed automation",
	"private": true,
	"scripts": {
		"test": "bun test --ignore-pattern '**/*.integration.test.ts' sites",
		"test:watch": "bun test --watch --ignore-pattern '**/*.integration.test.ts' sites",
		"test:integration": "bun test --testNamePattern integration sites",
		"test:all": "bun test sites"
	},
	"dependencies": {
		"cli-table3": "^0.6.5",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"ws": "^8.20.0"
	},
	"devDependencies": {
		"bun-types": "^1.3.11"
	}
}
